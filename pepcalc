def prompt_choice(label: str, options: list, display_fn=None) -> Optional[int]:
    if not options:
        return None
    for idx, item in enumerate(options, start=1):
        line = display_fn(item) if display_fn else str(item)
        print(f"{idx}) {line}")
    while True:
        raw = input(f"{label}: ").strip()
        if raw.lower() in ("q", "quit", "exit"):
