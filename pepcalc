def handle_edit(args: argparse.Namespace) -> int:
    conn = get_db()
    entries = db_list_peptides(conn)
    if not entries:
        conn.close()
        print("No saved peptides.")
        return 0

    entry = None
    if args.peptide:
        entry = db_get_peptide(conn, args.peptide)
        if not entry:
            conn.close()
            print(f"Error: '{args.peptide}' not found. Use `pepcalc list`.", file=sys.stderr)
            return 1
    else:
        entry = select_peptide_db(conn)
        if entry is None:
            print("No peptide selected.")
            conn.close()
            return 0

    if not check_course_warnings(conn, entry["id"], entry["name"], interactive=True):
        conn.close()
        return 0

    original_key = entry["key"]
    print(
        f"Editing {entry['name']} "
        f"(peptide: {fmt_num(entry['vial_mg'])}mg, "
        f"BAC: {fmt_num(entry['recon_ml'])}mL, "
        f"vial size: {fmt_num(get_vial_size_ml(entry))}mL, "
        f"dose: {fmt_dose_with_units(entry)})"
    )

    data_inputs = gather_mix_inputs(entry)
    print_mix_summary(data_inputs)

    new_key = normalize_name(data_inputs["name"])
    if new_key != original_key:
        existing = db_get_peptide(conn, data_inputs["name"])
        if existing:
            if not prompt_yes_no(f"Overwrite existing '{existing['name']}'", default=False):
                print("Edit cancelled.")
                conn.close()
                return 0

    if prompt_yes_no("Save changes", default=True):
        if new_key != original_key:
            db_delete_peptide(conn, original_key)
        db_save_peptide(
            conn,
            data_inputs["name"],
            data_inputs["vial_mg"],
            data_inputs["recon_ml"],
            data_inputs["dose_mcg"],
            data_inputs["vial_size_ml"],
        )
        print(f"Updated {data_inputs['name']}.")
    else:
        print("Edit cancelled.")
    conn.close()
    return 0


