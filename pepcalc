def db_list_protocol(conn: sqlite3.Connection) -> list:
    return conn.execute(
        "SELECT pe.id, pe.peptide_id, pe.syringe_id, pe.time_of_day, "
        "p.name AS peptide_name, p.vial_mg, p.recon_ml, p.dose_mcg, p.vial_size_ml, "
        "s.name AS syringe_name, s.capacity_cc "
        "FROM protocol_entries pe "
        "JOIN peptides p ON pe.peptide_id = p.id "
        "LEFT JOIN syringes s ON pe.syringe_id = s.id "
        "ORDER BY pe.time_of_day, p.name COLLATE NOCASE"
    ).fetchall()


def db_get_protocol_days(conn: sqlite3.Connection, entry_id: int) -> list:
    rows = conn.execute(
        "SELECT day_of_week FROM protocol_days WHERE protocol_entry_id = ? ORDER BY day_of_week",
        (entry_id,),
    ).fetchall()
    return [r["day_of_week"] for r in rows]


def db_add_protocol_entry(conn: sqlite3.Connection, peptide_id: int,
                          syringe_id: Optional[int], time_of_day: str,
                          days: list) -> int:
    cur = conn.execute(
        "INSERT INTO protocol_entries (peptide_id, syringe_id, time_of_day) VALUES (?, ?, ?)",
        (peptide_id, syringe_id, time_of_day),
    )
    entry_id = cur.lastrowid
    for d in days:
        conn.execute(
            "INSERT INTO protocol_days (protocol_entry_id, day_of_week) VALUES (?, ?)",
            (entry_id, d),
        )
    conn.commit()
    return entry_id


def db_update_protocol_entry(conn: sqlite3.Connection, entry_id: int,
                             syringe_id: Optional[int], time_of_day: str,
                             days: list) -> None:
    conn.execute(
        "UPDATE protocol_entries SET syringe_id=?, time_of_day=? WHERE id=?",
        (syringe_id, time_of_day, entry_id),
    )
    conn.execute("DELETE FROM protocol_days WHERE protocol_entry_id = ?", (entry_id,))
    for d in days:
        conn.execute(
            "INSERT INTO protocol_days (protocol_entry_id, day_of_week) VALUES (?, ?)",
            (entry_id, d),
        )
    conn.commit()


def db_delete_protocol_entry(conn: sqlite3.Connection, entry_id: int) -> None:
    conn.execute("DELETE FROM protocol_entries WHERE id = ?", (entry_id,))
    conn.commit()


def db_get_schedule_for_day(conn: sqlite3.Connection, day_of_week: int,
                            time_of_day: Optional[str] = None) -> list:
    sql = (
        "SELECT pe.id, pe.peptide_id, pe.syringe_id, pe.time_of_day, "
        "p.name AS peptide_name, p.vial_mg, p.recon_ml, p.dose_mcg, p.vial_size_ml, p.notes AS peptide_notes, "
        "s.name AS syringe_name, s.capacity_cc "
        "FROM protocol_entries pe "
        "JOIN peptides p ON pe.peptide_id = p.id "
        "LEFT JOIN syringes s ON pe.syringe_id = s.id "
        "JOIN protocol_days pd ON pd.protocol_entry_id = pe.id "
        "WHERE pd.day_of_week = ?"
    )
    params = [day_of_week]
    if time_of_day:
        sql += " AND pe.time_of_day = ?"
        params.append(time_of_day)
    sql += " ORDER BY pe.time_of_day, p.name COLLATE NOCASE"
    return conn.execute(sql, params).fetchall()


