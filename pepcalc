# ── Parser ───────────────────────────────────────────────────────────────────


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pepcalc",
        description="Peptide protocol management and reconstitution calculator",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  pepcalc calc BPC-157 5 2 250\n"
            "  pepcalc mix\n"
            "  pepcalc edit\n"
            "  pepcalc schedule\n"
            "  pepcalc protocol add"
        ),
    )
    subparsers = parser.add_subparsers(dest="command")

    # ── Existing commands ────────────────────────────────────────────────

    calc = subparsers.add_parser("calc", help="calculate syringe units per dose")
    calc.add_argument("peptide")
    calc.add_argument("vial_mg")
    calc.add_argument("recon_ml")
    calc.add_argument("dose_mcg")
    calc.set_defaults(func=handle_calc)

    save = subparsers.add_parser("save", help="save a peptide config")
    save.add_argument("peptide")
    save.add_argument("vial_mg")
    save.add_argument("recon_ml")
    save.add_argument("dose_mcg")
    save.add_argument("--vial-size-ml", help="vial size in mL (defaults to 3)")
    save.set_defaults(func=handle_save)

    list_cmd = subparsers.add_parser("list", help="list saved peptides")
    list_cmd.set_defaults(func=handle_list)

    dose = subparsers.add_parser("dose", help="calculate dose for a saved peptide")
    dose.add_argument("peptide")
    dose.set_defaults(func=handle_dose)

    edit = subparsers.add_parser("edit", help="edit a saved peptide")
    edit.add_argument("peptide", nargs="?")
    edit.set_defaults(func=handle_edit)

    mix = subparsers.add_parser("mix", help="interactive walkthrough for reconstitution volume")
    mix.set_defaults(func=handle_mix)

    # ── Schedule commands ────────────────────────────────────────────────

    schedule = subparsers.add_parser("schedule", help="show today's protocol card")
    schedule.add_argument("--morning", dest="time_filter", action="store_const", const="morning")
    schedule.add_argument("--night", dest="time_filter", action="store_const", const="night")
    schedule.add_argument("--all", dest="time_filter", action="store_const", const="all")
    schedule_sub = schedule.add_subparsers(dest="schedule_command")
    schedule.set_defaults(func=handle_schedule_week)

    schedule_week = schedule_sub.add_parser("week", help="weekly overview grid")
    schedule_week.set_defaults(func=handle_schedule_week)

    schedule_tomorrow = schedule_sub.add_parser("tomorrow", help="tomorrow's protocol card")
    schedule_tomorrow.add_argument("--morning", dest="time_filter", action="store_const", const="morning")
    schedule_tomorrow.add_argument("--night", dest="time_filter", action="store_const", const="night")
    schedule_tomorrow.add_argument("--all", dest="time_filter", action="store_const", const="all")
    schedule_tomorrow.set_defaults(func=handle_schedule_tomorrow)

    # ── Protocol commands ────────────────────────────────────────────────

    protocol = subparsers.add_parser("protocol", help="manage weekly dosing protocol")
    protocol_sub = protocol.add_subparsers(dest="protocol_command")
    protocol.set_defaults(func=handle_protocol)

    protocol_add = protocol_sub.add_parser("add", help="add peptide to protocol")
    protocol_add.set_defaults(func=handle_protocol_add)

    protocol_edit = protocol_sub.add_parser("edit", help="edit a protocol entry")
    protocol_edit.set_defaults(func=handle_protocol_edit)

    protocol_remove = protocol_sub.add_parser("remove", help="remove from protocol")
    protocol_remove.set_defaults(func=handle_protocol_remove)

    # ── Syringe commands ─────────────────────────────────────────────────

    syringe = subparsers.add_parser("syringe", help="manage syringes")
    syringe_sub = syringe.add_subparsers(dest="syringe_command")
    syringe.set_defaults(func=lambda _: handle_syringe_list(_))

    syringe_list = syringe_sub.add_parser("list", help="list saved syringes")
    syringe_list.set_defaults(func=handle_syringe_list)

    syringe_add = syringe_sub.add_parser("add", help="add a syringe")
    syringe_add.set_defaults(func=handle_syringe_add)

    syringe_edit = syringe_sub.add_parser("edit", help="edit a syringe")
    syringe_edit.set_defaults(func=handle_syringe_edit)

    syringe_remove = syringe_sub.add_parser("remove", help="remove a syringe")
    syringe_remove.set_defaults(func=handle_syringe_remove)

    # ── Supply commands ──────────────────────────────────────────────────

    supply = subparsers.add_parser("supply", help="manage supplies")
    supply_sub = supply.add_subparsers(dest="supply_command")
    supply.set_defaults(func=lambda _: handle_supply_list(_))

    supply_list = supply_sub.add_parser("list", help="list saved supplies")
    supply_list.set_defaults(func=handle_supply_list)

    supply_add = supply_sub.add_parser("add", help="add a supply")
    supply_add.set_defaults(func=handle_supply_add)

    supply_edit = supply_sub.add_parser("edit", help="edit a supply")
    supply_edit.set_defaults(func=handle_supply_edit)

    supply_remove = supply_sub.add_parser("remove", help="remove a supply")
    supply_remove.set_defaults(func=handle_supply_remove)

    # ── Inventory commands ───────────────────────────────────────────────

    inventory = subparsers.add_parser("inventory", help="manage vial inventory")
    inventory_sub = inventory.add_subparsers(dest="inventory_command")
    inventory.set_defaults(func=handle_inventory)

    inventory_add = inventory_sub.add_parser("add", help="add vials to inventory")
    inventory_add.set_defaults(func=handle_inventory_add)

    inventory_mix = inventory_sub.add_parser("mix", help="mark a vial as reconstituted")
    inventory_mix.set_defaults(func=handle_inventory_mix)

    inventory_remove = inventory_sub.add_parser("remove", help="remove a vial from inventory")
    inventory_remove.set_defaults(func=handle_inventory_remove)

    # ── Supplier commands ────────────────────────────────────────────────

    supplier = subparsers.add_parser("supplier", help="manage suppliers")
    supplier_sub = supplier.add_subparsers(dest="supplier_command")
    supplier.set_defaults(func=lambda _: handle_supplier_list(_))

    supplier_list = supplier_sub.add_parser("list", help="list saved suppliers")
    supplier_list.set_defaults(func=handle_supplier_list)

    supplier_add = supplier_sub.add_parser("add", help="add a supplier")
    supplier_add.set_defaults(func=handle_supplier_add)

    supplier_edit = supplier_sub.add_parser("edit", help="edit a supplier")
    supplier_edit.set_defaults(func=handle_supplier_edit)

    supplier_remove = supplier_sub.add_parser("remove", help="remove a supplier")
    supplier_remove.set_defaults(func=handle_supplier_remove)

    supplier_link = supplier_sub.add_parser("link", help="link supplier to item with price")
    supplier_link.set_defaults(func=handle_supplier_link)

    supplier_unlink = supplier_sub.add_parser("unlink", help="unlink supplier from item")
    supplier_unlink.set_defaults(func=handle_supplier_unlink)

    # ── Course commands ─────────────────────────────────────────────────

    course = subparsers.add_parser("course", help="manage course/cycle tracking")
    course_sub = course.add_subparsers(dest="course_command")
    course.set_defaults(func=handle_course)

    course_add = course_sub.add_parser("add", help="add course tracking for a peptide")
    course_add.set_defaults(func=handle_course_add)

    course_start = course_sub.add_parser("start", help="start a new course")
    course_start.set_defaults(func=handle_course_start)

    course_stop = course_sub.add_parser("stop", help="end the current course")
    course_stop.set_defaults(func=handle_course_stop)

    course_edit = course_sub.add_parser("edit", help="edit course configuration")
    course_edit.set_defaults(func=handle_course_edit)

    course_remove = course_sub.add_parser("remove", help="remove course tracking")
    course_remove.set_defaults(func=handle_course_remove)

    return parser


# ── Main ─────────────────────────────────────────────────────────────────────


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.command is None:
        print("Use `pepcalc -h` for help.")
        print("Examples: pepcalc calc BPC-157 5 2 250 | pepcalc mix | pepcalc schedule")
        return 0
    try:
        return args.func(args)
    except (UserExit, EOFError):
        print("Exited.")
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
