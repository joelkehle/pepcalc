# ── Mix workflow ─────────────────────────────────────────────────────────────


def gather_mix_inputs(entry) -> dict:
    name_default = entry["name"] if entry else None
    name = prompt_text("Peptide name", default=name_default, required=True)
    vial_default = entry["vial_mg"] if entry else None
    dose_default = entry["dose_mcg"] if entry else None
    recon_default = entry["recon_ml"] if entry else None
    vial_size_default = get_vial_size_ml(entry) if entry else DEFAULT_VIAL_SIZE_ML

    vial_mg = prompt_positive_float("Peptide amount (mg)", default=vial_default)
    dose_mcg = prompt_dose_mcg("Desired dose", default=dose_default)

    syringe_units = prompt_positive_float("Syringe max units (U-100)", default=100.0)
    min_units = prompt_positive_float("Minimum practical units per dose", default=2.0)
    vial_size_ml = prompt_positive_float("Vial size (mL)", default=vial_size_default)

    rec_target_ml, rec_units, max_units, max_units_by_vial = recommend_target_ml(
        vial_mg=vial_mg,
        dose_mcg=dose_mcg,
        syringe_units=syringe_units,
        min_units=min_units,
        vial_size_ml=vial_size_ml,
    )
    print(
        f"Recommendation: {fmt_num(rec_target_ml)}mL per dose "
        f"(~{fmt_num(rec_units)} units)."
    )
    if max_units < min_units:
        print(
            f"Note: constraints cap you at {fmt_num(max_units)} units per dose, "
            f"below your minimum of {fmt_num(min_units)}."
        )
    if max_units_by_vial is not None and max_units_by_vial < syringe_units:
        print(
            f"Note: vial volume caps you at {fmt_num(max_units_by_vial)} units per dose."
        )

    target_default = None
    target_default = rec_target_ml
    if recon_default:
        target_from_recon = (dose_mcg / (vial_mg * 1000.0)) * float(recon_default)
        max_reasonable_ml = min(vial_size_ml, syringe_units / 100.0)
        if 0 < target_from_recon <= max_reasonable_ml:
            target_default = target_from_recon
        else:
            print(
                f"Note: saved BAC implies {fmt_num(target_from_recon)}mL per dose; "
                "using recommendation instead."
            )
    target_ml = prompt_target_volume(default_ml=target_default)

    recon_ml = (vial_mg * 1000.0 * target_ml) / dose_mcg
    units_per_dose = target_ml * 100.0
    result = calculate(vial_mg, recon_ml, dose_mcg)

    return {
        "name": name,
        "vial_mg": vial_mg,
        "dose_mcg": dose_mcg,
        "recon_ml": recon_ml,
        "vial_size_ml": vial_size_ml,
        "target_ml": target_ml,
        "units_per_dose": units_per_dose,
        "result": result,
        "syringe_units": syringe_units,
        "min_units": min_units,
    }


def print_mix_summary(data: dict) -> None:
    print(f"{data['name']} (peptide: {fmt_num(data['vial_mg'])}mg)")
    print(
        "Target dose: "
        f"{fmt_dose(data['dose_mcg'])} at {fmt_num(data['target_ml'])}mL "
        f"({fmt_num(data['units_per_dose'])} units)"
    )
    print(f"BAC water to add: {fmt_num(data['recon_ml'])}mL")
    print(f"Vial size: {fmt_num(data['vial_size_ml'])}mL")
    result = data["result"]
    print(
        "Concentration: "
        f"{fmt_num(result['concentration_mg_ml'])}mg/mL "
        f"({fmt_num(result['concentration_mcg_ml'])}mcg/mL)"
    )
    if data["units_per_dose"] > data["syringe_units"]:
        print(
            f"Warning: dose is {fmt_num(data['units_per_dose'])} units, "
            f"exceeds syringe capacity of {fmt_num(data['syringe_units'])} units."
        )
    if data["units_per_dose"] < data["min_units"]:
        print(f"Note: doses under {fmt_num(data['min_units'])} units can be hard to measure.")
    if data["recon_ml"] > data["vial_size_ml"]:
        max_dose_ml = (data["dose_mcg"] / (data["vial_mg"] * 1000.0)) * data["vial_size_ml"]
        print(
            f"Warning: required volume {fmt_num(data['recon_ml'])}mL exceeds max vial volume "
            f"{fmt_num(data['vial_size_ml'])}mL."
        )
        print(
            f"Max vial volume yields {fmt_num(max_dose_ml)}mL per dose "
            f"({fmt_num(max_dose_ml * 100)} units)."
        )


