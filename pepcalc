def _resolve_item_name(conn: sqlite3.Connection, item_type: str, item_id: int) -> str:
    if item_type == "peptide":
        row = db_get_peptide_by_id(conn, item_id)
        return row["name"] if row else f"(deleted peptide #{item_id})"
    elif item_type == "syringe":
        row = db_get_syringe(conn, item_id)
        return row["name"] if row else f"(deleted syringe #{item_id})"
    elif item_type == "supply":
        row = db_get_supply(conn, item_id)
        return row["name"] if row else f"(deleted supply #{item_id})"
    return f"(unknown {item_type} #{item_id})"


