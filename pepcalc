                date_str = v["reconstituted_date"]
            state_str = f"reconstituted (mixed {date_str})"
        else:
            state_str = v["state"]
        notes_str = f"  - {v['notes']}" if v["notes"] else ""
        print(f"  1 {state_str}{notes_str}")
    return 0


def handle_inventory_add(_: argparse.Namespace) -> int:
    conn = get_db()
    peptides = db_list_peptides(conn)
    if not peptides:
        conn.close()
        print("No saved peptides. Use `pepcalc save` first.")
        return 1
    print("Select peptide:")
    idx = prompt_choice(
        "Peptide",
        peptides,
        display_fn=lambda p: f"{p['name']} ({fmt_num(p['vial_mg'])}mg)",
    )
    if idx is None:
        conn.close()
        return 0
    peptide = peptides[idx]
    count = prompt_optional_int("How many vials", default=1) or 1
    print("State:")
    states = [("lyophilized", "Lyophilized (powder)"), ("reconstituted", "Reconstituted (mixed)")]
    state_idx = prompt_choice("State", states, display_fn=lambda s: s[1])
    state = states[state_idx][0] if state_idx is not None else "lyophilized"
    recon_date = None
    if state == "reconstituted":
        date_str = prompt_text("Reconstituted date (YYYY-MM-DD)", default=datetime.date.today().isoformat())
        recon_date = date_str
    notes = prompt_text("Notes", required=False) or None
    for _ in range(count):
        db_add_vial(conn, peptide["id"], state, recon_date, notes)
    conn.close()
    label = "vial" if count == 1 else "vials"
    print(f"Added {count} {state} {label} of {peptide['name']}.")
    return 0


def handle_inventory_mix(_: argparse.Namespace) -> int:
    conn = get_db()
    lyoph = conn.execute(
        "SELECT v.*, p.name AS peptide_name, p.vial_mg "
        "FROM vials v JOIN peptides p ON v.peptide_id = p.id "
        "WHERE v.state = 'lyophilized' "
        "ORDER BY p.name COLLATE NOCASE, v.id"
    ).fetchall()
    if not lyoph:
        conn.close()
        print("No lyophilized vials to reconstitute.")
        return 0
    print("Select vial to reconstitute:")
    idx = prompt_choice(
        "Vial",
        lyoph,
        display_fn=lambda v: f"{v['peptide_name']} {fmt_num(v['vial_mg'])}mg (lyophilized)"
                              + (f"  - {v['notes']}" if v["notes"] else ""),
    )
    if idx is None:
        conn.close()
        return 0
    vial = lyoph[idx]
    date_str = prompt_text("Reconstituted date (YYYY-MM-DD)", default=datetime.date.today().isoformat())
    db_update_vial_state(conn, vial["id"], "reconstituted", date_str)
    conn.close()
    print(f"Marked {vial['peptide_name']} vial as reconstituted ({date_str}).")
    return 0


def handle_inventory_remove(_: argparse.Namespace) -> int:
    conn = get_db()
    vials = db_list_vials(conn)
    if not vials:
        conn.close()
        print("No vials in inventory.")
        return 0
    print("Select vial to remove:")

    def display_vial(v):
        state_str = v["state"]
        if v["state"] == "reconstituted" and v["reconstituted_date"]:
            state_str = f"reconstituted (mixed {v['reconstituted_date']})"
        desc = f"{v['peptide_name']} {fmt_num(v['vial_mg'])}mg ({state_str})"
        if v["notes"]:
            desc += f"  - {v['notes']}"
        return desc

    idx = prompt_choice("Vial", vials, display_fn=display_vial)
    if idx is None:
        conn.close()
        return 0
    vial = vials[idx]
    if prompt_yes_no(f"Remove {vial['peptide_name']} vial ({vial['state']})", default=False):
        db_delete_vial(conn, vial["id"])
        print(f"Removed {vial['peptide_name']} vial.")
    else:
        print("Cancelled.")
    conn.close()
    return 0


# ── Handlers: course commands ──────────────────────────────────────────────


def handle_course(_: argparse.Namespace) -> int:
    conn = get_db()
    courses = db_list_courses(conn)
    if not courses:
        conn.close()
        print("No course tracking configured. Use `pepcalc course add` to set one up.")
        return 0
    today = datetime.date.today()
    for c in courses:
        dur = f"{c['duration_min']}"
        if c["duration_max"]:
            dur += f"-{c['duration_max']}"
        if c["active_start"]:
            start = datetime.date.fromisoformat(c["active_start"])
            day_num = (today - start).days + 1
            target = c["target_duration"] or c["duration_min"]
            end_date = start + datetime.timedelta(days=target - 1)
            start_str = start.strftime("%b %-d")
            end_str = end_date.strftime("%b %-d")
            line = f"{c['peptide_name']} — Day {day_num} of {target} (range {dur}, started {start_str}, end ~{end_str})"
            if c["duration_max"] and day_num > c["duration_max"]:
                line += "  ⚠ past max duration"
            elif day_num > target:
                line += "  — past target, consider ending"
        else:
            line = f"{c['peptide_name']} — Off-cycle"
            if c["last_completed"] and c["gap_days"]:
                last = datetime.date.fromisoformat(c["last_completed"])
                next_due = last + datetime.timedelta(days=c["gap_days"])
                line += f". Last course ended {last.strftime('%b %-d')}. Next due ~{next_due.strftime('%b %-d')}."
        print(line)
    conn.close()
    return 0


def handle_course_add(_: argparse.Namespace) -> int:
    conn = get_db()
    peptides = db_list_peptides(conn)
    if not peptides:
        conn.close()
        print("No saved peptides. Use `pepcalc save` first.")
        return 1
    # Filter out peptides that already have course tracking
    existing_ids = {c["peptide_id"] for c in db_list_courses(conn)}
    available = [p for p in peptides if p["id"] not in existing_ids]
    if not available:
        conn.close()
        print("All peptides already have course tracking configured.")
        return 0
    print("Select peptide for course tracking:")
    idx = prompt_choice(
        "Peptide",
        available,
        display_fn=lambda p: p["name"],
    )
    if idx is None:
        conn.close()
        return 0
    peptide = available[idx]
    duration_min = prompt_optional_int("Minimum course length (days)", default=30) or 30
    duration_max = prompt_optional_int("Maximum course length (days)")
    target_duration = prompt_optional_int("Target duration (days)", default=duration_min)
    gap_days = prompt_optional_int("Recommended gap between courses (days)")
    notes = prompt_text("Notes", required=False) or None
    db_add_course(conn, peptide["id"], duration_min, duration_max, target_duration, gap_days, notes)
    conn.close()
    dur = f"{duration_min}"
    if duration_max:
        dur += f"-{duration_max}"
    print(f"Added course tracking for {peptide['name']} ({dur} days).")
    return 0


def handle_course_start(_: argparse.Namespace) -> int:
    conn = get_db()
    courses = db_list_courses(conn)
    inactive = [c for c in courses if not c["active_start"]]
    if not inactive:
        conn.close()
        if courses:
            print("All tracked courses are already active.")
        else:
            print("No course tracking configured. Use `pepcalc course add` first.")
        return 0
    print("Select course to start:")
    idx = prompt_choice(
        "Course",
        inactive,
        display_fn=lambda c: c["peptide_name"],
    )
    if idx is None:
        conn.close()
        return 0
    course = inactive[idx]
    date_str = prompt_text("Start date (YYYY-MM-DD)", default=datetime.date.today().isoformat())
    db_start_course(conn, course["id"], date_str)
    conn.close()
    print(f"Started course for {course['peptide_name']} ({date_str}).")
    return 0


def handle_course_stop(_: argparse.Namespace) -> int:
    conn = get_db()
    courses = db_list_courses(conn)
    active = [c for c in courses if c["active_start"]]
    if not active:
        conn.close()
        print("No active courses to stop.")
        return 0
    print("Select course to stop:")

    def display_active(c):
        start = datetime.date.fromisoformat(c["active_start"])
        day_num = (datetime.date.today() - start).days + 1
        return f"{c['peptide_name']} (day {day_num})"

    idx = prompt_choice("Course", active, display_fn=display_active)
    if idx is None:
        conn.close()
        return 0
    course = active[idx]
    date_str = prompt_text("End date (YYYY-MM-DD)", default=datetime.date.today().isoformat())
    db_stop_course(conn, course["id"], date_str)
    conn.close()
    print(f"Stopped course for {course['peptide_name']} ({date_str}).")
    return 0


