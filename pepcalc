    today = datetime.date.today()
    status = {
        "course": course,
        "active": False,
        "day_number": 0,
        "past_min": False,
        "past_max": False,
        "off_cycle": True,
        "next_due_date": None,
    }
    if course["active_start"]:
        start = datetime.date.fromisoformat(course["active_start"])
        day_num = (today - start).days + 1
        status["active"] = True
        status["off_cycle"] = False
        status["day_number"] = day_num
        status["past_min"] = day_num > course["duration_min"]
        if course["duration_max"]:
            status["past_max"] = day_num > course["duration_max"]
    elif course["last_completed"] and course["gap_days"]:
        last = datetime.date.fromisoformat(course["last_completed"])
        next_due = last + datetime.timedelta(days=course["gap_days"])
        status["next_due_date"] = next_due
    return status


def check_course_warnings(conn: sqlite3.Connection, peptide_id: int,
                          peptide_name: str, interactive: bool = False) -> bool:
    """Print course warnings. If interactive, prompt to continue. Returns True to proceed."""
    status = get_course_status(conn, peptide_id)
    if not status:
        return True
    course = status["course"]
    dur = f"{course['duration_min']}"
    if course["duration_max"]:
        dur += f"-{course['duration_max']}"
    if status["active"]:
        if status["past_max"]:
            print(f"Note: {peptide_name} course is at day {status['day_number']} (max {course['duration_max']}). Consider ending the course.")
        elif status["past_min"]:
            print(f"Note: {peptide_name}: Day {status['day_number']} of {dur} day course — consider ending soon.")
    else:
        msg = f"Note: {peptide_name} is off-cycle."
        if status["next_due_date"]:
            msg += f" Next course due ~{status['next_due_date'].strftime('%b %-d')}."
        print(msg)
    if interactive and (not status["active"] or status["past_max"]):
        if not prompt_yes_no("Continue", default=True):
            return False
    return True


# ── Calculation ──────────────────────────────────────────────────────────────


def recommend_target_ml(
    vial_mg: float,
    dose_mcg: float,
    syringe_units: float,
    min_units: float,
    vial_size_ml: Optional[float],
    preferred_units: float = 10.0,
) -> Tuple[float, float, float, Optional[float]]:
    max_units = syringe_units
    max_units_by_vial = None
    if vial_size_ml is not None:
        max_target_ml = (vial_size_ml * dose_mcg) / (vial_mg * 1000.0)
        max_units_by_vial = max_target_ml * 100.0
        max_units = min(max_units, max_units_by_vial)
    recommended_units = min(max(preferred_units, min_units), max_units)
    return recommended_units / 100.0, recommended_units, max_units, max_units_by_vial


def calculate(vial_mg: float, recon_ml: float, dose_mcg: float) -> dict:
    concentration_mg_ml = vial_mg / recon_ml
    concentration_mcg_ml = concentration_mg_ml * 1000.0
    units = (dose_mcg / concentration_mcg_ml) * 100.0
    return {
        "concentration_mg_ml": concentration_mg_ml,
        "concentration_mcg_ml": concentration_mcg_ml,
        "units": units,
    }


def format_output(
    name: str,
    vial_mg: float,
    recon_ml: float,
    dose_mcg: float,
    vial_size_ml: Optional[float] = None,
) -> str:
    result = calculate(vial_mg, recon_ml, dose_mcg)
    line1 = f"{name} (peptide: {fmt_num(vial_mg)}mg, BAC: {fmt_num(recon_ml)}mL"
    if vial_size_ml:
        line1 += f", vial size: {fmt_num(vial_size_ml)}mL"
    line1 += ")"
    line2 = (
        "Concentration: "
        f"{fmt_num(result['concentration_mg_ml'])}mg/mL "
        f"({fmt_num(result['concentration_mcg_ml'])}mcg/mL)"
    )
    line3 = f"Dose: {fmt_dose(dose_mcg)} = {fmt_num(result['units'])} units"
    return "\n".join([line1, line2, line3])


