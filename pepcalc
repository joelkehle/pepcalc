# ── Formatting helpers ───────────────────────────────────────────────────────


def normalize_name(name: str) -> str:
    return name.strip().lower()


def fmt_num(value: float, max_dec: int = 2) -> str:
    text = f"{value:.{max_dec}f}".rstrip("0").rstrip(".")
    return text if text else "0"


def get_vial_size_ml(entry) -> float:
    if not entry:
        return DEFAULT_VIAL_SIZE_ML
    try:
        value = entry["vial_size_ml"]
    except (KeyError, TypeError):
        value = entry.get("vial_size_ml") if isinstance(entry, dict) else None
    return float(value) if value else DEFAULT_VIAL_SIZE_ML


def parse_positive_float(value: str, label: str) -> float:
    try:
        num = float(value)
    except ValueError:
        raise ValueError(f"{label} must be a number.")
    if num <= 0:
        raise ValueError(f"{label} must be greater than 0.")
    return num


def parse_dose_input(raw: str, label: str = "dose") -> float:
    text = raw.strip().lower().replace(" ", "")
    match = re.fullmatch(r"([0-9]*\.?[0-9]+)([a-z]*)", text)
    if not match:
        raise ValueError(f"{label} must be a number with optional unit (mcg or mg).")
    value = float(match.group(1))
    unit = match.group(2)
    if unit in ("", "mcg", "ug"):
        mcg = value
    elif unit == "mg":
        mcg = value * 1000.0
    else:
        raise ValueError(f"{label} unit must be mcg or mg.")
    if mcg <= 0:
        raise ValueError(f"{label} must be greater than 0.")
    return mcg


def parse_volume_or_units_input(raw: str, label: str = "target volume") -> Tuple[float, str]:
    text = raw.strip().lower().replace(" ", "")
    match = re.fullmatch(r"([0-9]*\.?[0-9]+)([a-z]*)", text)
    if not match:
        raise ValueError(f"{label} must be a number with optional unit (mL or units).")
    value = float(match.group(1))
    unit = match.group(2)
    if value <= 0:
        raise ValueError(f"{label} must be greater than 0.")
    if unit in ("",):
        return value, "none"
    if unit == "ml":
        return value, "ml"
    if unit in ("u", "unit", "units"):
        return value / 100.0, "units"
    raise ValueError(f"{label} unit must be mL or units.")


def fmt_dose(mcg: float) -> str:
    if mcg >= 1000:
        return f"{fmt_num(mcg / 1000.0)}mg ({fmt_num(mcg)}mcg)"
    return f"{fmt_num(mcg)}mcg"


def fmt_dose_with_units(entry) -> str:
    result = calculate(entry["vial_mg"], entry["recon_ml"], entry["dose_mcg"])
    dose_mcg = entry["dose_mcg"]
    dose_mg = dose_mcg / 1000.0
    if dose_mcg >= 1000:
        primary = f"{fmt_num(dose_mg)}mg"
        secondary = f"{fmt_num(dose_mcg)}mcg"
    else:
        primary = f"{fmt_num(dose_mcg)}mcg"
        secondary = f"{fmt_num(dose_mg, 4)}mg"
    return f"{primary} ({secondary}, {fmt_num(result['units'])}u)"


# ── Database layer ───────────────────────────────────────────────────────────


def get_db() -> sqlite3.Connection:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    is_new = not DB_PATH.exists()
    conn = sqlite3.connect(str(DB_PATH))
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA foreign_keys=ON")
    if is_new:
        init_schema(conn)
        migrate_json(conn)
    else:
        maybe_upgrade_schema(conn)
    return conn


def init_schema(conn: sqlite3.Connection) -> None:
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS schema_version (version INTEGER NOT NULL);

        CREATE TABLE IF NOT EXISTS peptides (
            id           INTEGER PRIMARY KEY AUTOINCREMENT,
            key          TEXT NOT NULL UNIQUE,
            name         TEXT NOT NULL,
            vial_mg      REAL NOT NULL,
            recon_ml     REAL NOT NULL,
            dose_mcg     REAL NOT NULL,
            vial_size_ml REAL NOT NULL DEFAULT 3.0,
            notes        TEXT
        );

        CREATE TABLE IF NOT EXISTS syringes (
            id            INTEGER PRIMARY KEY AUTOINCREMENT,
            name          TEXT NOT NULL,
            brand         TEXT,
            gauge         INTEGER,
            capacity_cc   REAL NOT NULL,
            needle_length TEXT,
            description   TEXT
        );

        CREATE TABLE IF NOT EXISTS supplies (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            name        TEXT NOT NULL,
            category    TEXT,
            description TEXT
        );

        CREATE TABLE IF NOT EXISTS suppliers (
            id   INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            url  TEXT
        );

        CREATE TABLE IF NOT EXISTS supplier_items (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            supplier_id INTEGER NOT NULL REFERENCES suppliers(id) ON DELETE CASCADE,
            item_type   TEXT NOT NULL CHECK(item_type IN ('peptide', 'syringe', 'supply')),
            item_id     INTEGER NOT NULL,
            price       REAL,
            notes       TEXT,
            UNIQUE(supplier_id, item_type, item_id)
        );

        CREATE TABLE IF NOT EXISTS protocol_entries (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            peptide_id  INTEGER NOT NULL REFERENCES peptides(id) ON DELETE CASCADE,
            syringe_id  INTEGER REFERENCES syringes(id) ON DELETE SET NULL,
            time_of_day TEXT NOT NULL DEFAULT 'night' CHECK(time_of_day IN ('morning', 'night')),
            UNIQUE(peptide_id)
        );

        CREATE TABLE IF NOT EXISTS protocol_days (
            id                INTEGER PRIMARY KEY AUTOINCREMENT,
            protocol_entry_id INTEGER NOT NULL REFERENCES protocol_entries(id) ON DELETE CASCADE,
            day_of_week       INTEGER NOT NULL CHECK(day_of_week BETWEEN 0 AND 6),
            UNIQUE(protocol_entry_id, day_of_week)
        );

        CREATE TABLE IF NOT EXISTS vials (
            id                 INTEGER PRIMARY KEY AUTOINCREMENT,
            peptide_id         INTEGER NOT NULL REFERENCES peptides(id) ON DELETE CASCADE,
            state              TEXT NOT NULL DEFAULT 'lyophilized'
                               CHECK(state IN ('lyophilized', 'reconstituted')),
            reconstituted_date TEXT,
            notes              TEXT
        );

        CREATE TABLE IF NOT EXISTS courses (
            id              INTEGER PRIMARY KEY AUTOINCREMENT,
            peptide_id      INTEGER NOT NULL REFERENCES peptides(id) ON DELETE CASCADE,
            duration_min    INTEGER NOT NULL,
            duration_max    INTEGER,
            target_duration INTEGER,
            gap_days        INTEGER,
            active_start    TEXT,
            last_completed  TEXT,
            notes           TEXT,
            UNIQUE(peptide_id)
        );
    """)
    conn.execute("DELETE FROM schema_version")
    conn.execute("INSERT INTO schema_version (version) VALUES (?)", (SCHEMA_VERSION,))
    conn.commit()


def maybe_upgrade_schema(conn: sqlite3.Connection) -> None:
    try:
        row = conn.execute("SELECT version FROM schema_version").fetchone()
    except sqlite3.OperationalError:
        init_schema(conn)
        migrate_json(conn)
        return
    if row is None:
        init_schema(conn)
        migrate_json(conn)
        return
    if row["version"] < 2:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS vials (
                id                 INTEGER PRIMARY KEY AUTOINCREMENT,
                peptide_id         INTEGER NOT NULL REFERENCES peptides(id) ON DELETE CASCADE,
                state              TEXT NOT NULL DEFAULT 'lyophilized'
                                   CHECK(state IN ('lyophilized', 'reconstituted')),
                reconstituted_date TEXT,
                notes              TEXT
            )
        """)
        conn.execute("UPDATE schema_version SET version = 2")
        conn.commit()
    if row["version"] < 3:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS courses (
                id              INTEGER PRIMARY KEY AUTOINCREMENT,
                peptide_id      INTEGER NOT NULL REFERENCES peptides(id) ON DELETE CASCADE,
                duration_min    INTEGER NOT NULL,
                duration_max    INTEGER,
                target_duration INTEGER,
                gap_days        INTEGER,
                active_start    TEXT,
                last_completed  TEXT,
                notes           TEXT,
                UNIQUE(peptide_id)
            )
        """)
        conn.execute("UPDATE schema_version SET version = 3")
        conn.commit()
    if row["version"] < 4:
        conn.execute("ALTER TABLE peptides ADD COLUMN notes TEXT")
        conn.execute("UPDATE schema_version SET version = 4")
        conn.commit()
    if row["version"] < 5:
        conn.execute("ALTER TABLE courses ADD COLUMN target_duration INTEGER")
        conn.execute("UPDATE courses SET target_duration = duration_min WHERE target_duration IS NULL")
        conn.execute("UPDATE schema_version SET version = 5")
        conn.commit()


def migrate_json(conn: sqlite3.Connection) -> None:
    if not CONFIG_PATH.exists():
        return
    try:
        data = json.loads(CONFIG_PATH.read_text())
    except (json.JSONDecodeError, OSError):
        return
    peptides = data.get("peptides", {})
    if not isinstance(peptides, dict):
        return
    migrated = 0
    for key, entry in peptides.items():
        if not isinstance(entry, dict):
            continue
        try:
            conn.execute(
                "INSERT OR IGNORE INTO peptides (key, name, vial_mg, recon_ml, dose_mcg, vial_size_ml) "
                "VALUES (?, ?, ?, ?, ?, ?)",
                (
                    normalize_name(key),
                    entry.get("name", key),
                    float(entry["vial_mg"]),
                    float(entry["recon_ml"]),
                    float(entry["dose_mcg"]),
                    float(entry.get("vial_size_ml", DEFAULT_VIAL_SIZE_ML)),
                ),
            )
            migrated += 1
        except (KeyError, ValueError, TypeError):
            continue
    conn.commit()
    if migrated > 0:
        migrated_path = CONFIG_PATH.with_suffix(".json.migrated")
        try:
            CONFIG_PATH.rename(migrated_path)
        except OSError:
            pass


