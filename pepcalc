def handle_schedule_week(_: argparse.Namespace) -> int:
    conn = get_db()
    entries = db_list_protocol(conn)
    if not entries:
        conn.close()
        print("No protocol entries. Use `pepcalc protocol add` to create one.")
        return 0

    # Build grid data
    today = datetime.date.today()
    today_weekday = today.weekday()
    rows = []
    for e in entries:
        days = db_get_protocol_days(conn, e["id"])
        time_tag = "(M)" if e["time_of_day"] == "morning" else "(N)"
        course = db_get_course(conn, e["peptide_id"])
        row = {
            "name": e["peptide_name"],
            "time_tag": time_tag,
            "days": set(days),
            "course": course,
            "end_suffix": "",
        }
        # Compute day numbers and end info for active courses
        if course and course["active_start"]:
            start = datetime.date.fromisoformat(course["active_start"])
            today_day_num = (today - start).days + 1
            target = course["target_duration"] or course["duration_min"]
            end_date = start + datetime.timedelta(days=target - 1)
            row["end_suffix"] = f"  \u2192 end day {target} (~{end_date.strftime('%b %-d')})"
            # Compute day number for each weekday (Mon=0..Sun=6) relative to today
            day_nums = {}
            for d in range(7):
                offset = d - today_weekday
                day_nums[d] = today_day_num + offset
            row["day_nums"] = day_nums
        else:
            row["day_nums"] = None
        rows.append(row)

    # Calculate column widths
    max_name = max(len(r["name"]) for r in rows)
    name_col = max(max_name + 6, 14)  # +6 for " (N) "

    print("Weekly Protocol")
    sep = "\u2500" * (name_col + 5 * 7 + 2)
    print(sep)
    header = " " * name_col + "".join(f"{d:>5}" for d in DAY_NAMES)
    print(header)

    for r in rows:
        label = f"{r['name']}  {r['time_tag']}"
        line = f"{label:<{name_col}}"
        for d in range(7):
            if d not in r["days"]:
                line += "   - "
            elif r["day_nums"] is not None and r["day_nums"][d] >= 1:
                line += f"{r['day_nums'][d]:>4} "
            else:
                line += "   * "
        line += r["end_suffix"]
        print(line)

    print(sep)
    print("(N) = night, (M) = morning")

    # Today's detail card
    day_name = DAY_NAMES[today_weekday]
    today_entries = db_get_schedule_for_day(conn, today_weekday)
    if today_entries:
        print()
        print(f"Today ({day_name})")
        print("\u2500" * 40)
        for e in today_entries:
            result = calculate(e["vial_mg"], e["recon_ml"], e["dose_mcg"])
            time_tag = "(M)" if e["time_of_day"] == "morning" else "(N)"
            print(f"  {e['peptide_name']} {time_tag}: {fmt_dose(e['dose_mcg'])} \u2192 {fmt_num(result['units'])} units")
            if e["syringe_name"]:
                print(f"    Syringe: {e['syringe_name']}")
            if e["peptide_notes"]:
                print(f"    Note: {e['peptide_notes']}")
            print()

        # Course status lines for today's peptides
        seen_peptides = set()
        for e in today_entries:
            if e["peptide_id"] in seen_peptides:
                continue
            seen_peptides.add(e["peptide_id"])
            status = get_course_status(conn, e["peptide_id"])
            if not status:
                continue
            course = status["course"]
            dur = f"{course['duration_min']}"
            if course["duration_max"]:
                dur += f"-{course['duration_max']}"
            if status["active"]:
                if status["past_max"]:
                    print(f"  \u26a0 {e['peptide_name']}: Day {status['day_number']} of {dur} day course \u2014 past max duration")
                elif status["past_min"]:
                    print(f"  \u26a0 {e['peptide_name']}: Day {status['day_number']} of {dur} day course \u2014 consider ending soon")
            else:
                msg = f"  \u2139 {e['peptide_name']}: Off-cycle"
                if status["next_due_date"]:
                    msg += f" (next course due ~{status['next_due_date'].strftime('%b %-d')})"
                print(msg)

    conn.close()
    return 0


