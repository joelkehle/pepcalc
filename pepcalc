# ── Days parsing ─────────────────────────────────────────────────────────────


def parse_days_input(raw: str) -> list:
    text = raw.strip().lower()
    if text in ("daily", "everyday", "every day", "all"):
        return list(range(7))
    if text in ("weekdays", "weekday"):
        return list(range(5))
    if text in ("weekends", "weekend"):
        return [5, 6]
    # Try "MWF" style (single letters for unambiguous days)
    if re.fullmatch(r"[mtwfsa]{1,7}", text) and len(text) <= 7:
        days = set()
        for ch in text:
            if ch == "m":
                days.add(0)
            elif ch == "t":
                days.add(1)
            elif ch == "w":
                days.add(2)
            elif ch == "h":
                days.add(3)
            elif ch == "f":
                days.add(4)
            elif ch == "s":
                days.add(5)
            elif ch == "a":
                # 'a' = saturday (sa) when used in single-char mode? No, ambiguous.
                # Let's just fall through to comma-separated
                pass
        if days:
            return sorted(days)
    # Try comma/space separated: "Mon, Wed, Fri" or "mon wed fri"
    parts = re.split(r"[,\s]+", text)
    days = set()
    for part in parts:
        part = part.strip().rstrip(",")
        if not part:
            continue
        if part in DAY_ALIASES:
            days.add(DAY_ALIASES[part])
        else:
            raise ValueError(f"Unknown day: '{part}'. Use Mon,Tue,Wed,Thu,Fri,Sat,Sun or 'daily'.")
    if not days:
        raise ValueError("No days specified.")
    return sorted(days)


def format_days(days: list) -> str:
    if days == list(range(7)):
        return "daily"
    if days == list(range(5)):
        return "weekdays"
    if days == [5, 6]:
        return "weekends"
    return ", ".join(DAY_NAMES[d] for d in sorted(days))


def prompt_days(default: Optional[list] = None) -> list:
    default_str = format_days(default) if default else None
    while True:
        suffix = f" [{default_str}]" if default_str else ""
        raw = input(f"Days (e.g. MWF, Mon,Wed,Fri, daily, weekdays){suffix}: ").strip()
        if raw.lower() in ("q", "quit", "exit"):
            raise UserExit()
        if not raw:
            if default is not None:
                return default
            print("Please enter days.")
            continue
        try:
            return parse_days_input(raw)
        except ValueError as exc:
            print(exc)


def prompt_time_of_day(default: str = "night") -> str:
