# ── Config directory ─────────────────────────────────────────────────────────


def get_config_dir() -> Path:
    if os.name == "nt":
        base = os.environ.get("APPDATA") or os.environ.get("LOCALAPPDATA")
        if base:
            return Path(base) / "pepcalc"
    xdg_home = os.environ.get("XDG_CONFIG_HOME")
    if xdg_home:
        return Path(xdg_home) / "pepcalc"
    return Path.home() / ".config" / "pepcalc"


